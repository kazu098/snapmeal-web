---
interface Props {
  pageTitle: string;
  pageHref: string;
}

const { pageTitle, pageHref } = Astro.props;

const siteUrl = 'https://snap-meal.com';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Snapmeal',
      item: siteUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'ブログ',
      item: `${siteUrl}/blog/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: pageTitle,
      item: `${siteUrl}${pageHref}`,
    },
  ],
};
---

<nav class="breadcrumb" aria-label="パンくずリスト">
  <ol>
    <li>
      <a href="/">Snapmeal</a>
    </li>
    <li aria-hidden="true" class="sep">›</li>
    <li>
      <a href="/blog/">ブログ</a>
    </li>
    <li aria-hidden="true" class="sep">›</li>
    <li aria-current="page" class="current">{pageTitle}</li>
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .breadcrumb {
    margin-bottom: 1.25rem;
  }
  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.8rem;
    color: rgb(107 114 128);
  }
  .breadcrumb a {
    color: rgb(107 114 128);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.15s;
  }
  .breadcrumb a:hover {
    color: rgb(5 150 105);
  }
  .sep {
    color: rgb(209 213 219);
    font-size: 0.75rem;
  }
  .current {
    color: rgb(107 114 128);
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 280px;
  }
  @media (max-width: 640px) {
    .current { max-width: 180px; }
  }
</style>
