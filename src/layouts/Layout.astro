---
import StickyAppCta from '../components/StickyAppCta.astro';
import { articles } from '../data/articles';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  lang?: 'ja' | 'en';
  alternateUrl?: string;
}

const { lang = 'ja' } = Astro.props;

const defaults = {
  ja: {
    title: 'Snapmeal — 冷蔵庫を撮るだけ。30秒で今夜の献立が決まる',
    description: 'ベータ版公開中・全機能無料。冷蔵庫を撮影するだけでAIが食材を認識し、今夜の献立をすぐ提案。ホットクック対応・疲れた日モード搭載。',
    ogImage: '/og-ja.png',
    ogLocale: 'ja_JP',
  },
  en: {
    title: "Snapmeal — Just snap your fridge. Dinner in 30 seconds.",
    description: "Beta is live — all features free. AI reads your fridge and suggests tonight's meal instantly. Smart Cooker support, Tired Mode, and more.",
    ogImage: '/og-en.png',
    ogLocale: 'en_US',
  },
};

const base = defaults[lang];
const title = Astro.props.title ?? base.title;
const description = Astro.props.description ?? base.description;
const ogImage = Astro.props.ogImage ?? base.ogImage;
const ogLocale = base.ogLocale;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const alternateUrl = Astro.props.alternateUrl;

// GA4 Measurement ID — 環境変数 PUBLIC_GA_ID に設定する (例: G-XXXXXXXXXX)
const gaId = import.meta.env.PUBLIC_GA_ID ?? 'G-9MQ8NH6HE8';

// ブログ記事ページ（/blog/[slug]/）のみスティッキーCTAを表示
const isBlogArticle = /^\/(?:en\/)?blog\/(?!tag\/|[0-9]+\/)([^/]+)\/$/.test(Astro.url.pathname);
const showStickyCta = isBlogArticle && !Astro.url.pathname.startsWith('/en/');

// 記事メタデータ（articles.tsにある日本語記事のみ）
const currentArticle = isBlogArticle
  ? articles.find((a) => a.href === Astro.url.pathname)
  : undefined;

function jaDateToISO(jaDate: string): string {
  const m = jaDate.match(/(\d{4})年(\d{1,2})月(\d{1,2})日/);
  if (!m) return '';
  return `${m[1]}-${m[2].padStart(2, '0')}-${m[3].padStart(2, '0')}`;
}

const ogType = currentArticle ? 'article' : 'website';
const publishedTime = currentArticle ? jaDateToISO(currentArticle.date) : '';
// ブログサムネイルは 1600×900
const ogImageWidth = ogImage.includes('/blog/') ? '1600' : '1200';
const ogImageHeight = ogImage.includes('/blog/') ? '900' : '630';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalURL} />
    {lang === 'ja' && alternateUrl && <link rel="alternate" hreflang="en" href={alternateUrl} />}
    {lang === 'en' && alternateUrl && <link rel="alternate" hreflang="ja" href={alternateUrl} />}
    <link rel="alternate" hreflang="x-default" href="https://snap-meal.com/" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- OGP -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content={ogImageWidth} />
    <meta property="og:image:height" content={ogImageHeight} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="Snapmeal" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@snap_meal_app" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Google Analytics 4 -->
    {gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function() { window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', gaId, { send_page_view: true });
        </script>
      </>
    )}
  </head>
  <body class="bg-white text-gray-900 font-sans antialiased">
    <slot />
    {showStickyCta && <StickyAppCta />}

    <!-- コンバージョントラッキング: data-ga-event="xxx" のボタン/リンクを監視 -->
    <script is:inline>
      document.addEventListener('click', function(e) {
        var el = e.target && e.target.closest('[data-ga-event]');
        if (!el || !window.gtag) return;
        var eventName = el.getAttribute('data-ga-event') || 'cta_click';
        var label = el.getAttribute('data-ga-label') || el.textContent.trim();
        window.gtag('event', eventName, { event_label: label });
      });
    </script>
  </body>
</html>
