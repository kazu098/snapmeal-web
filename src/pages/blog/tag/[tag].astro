---
import Layout from '../../../layouts/Layout.astro';
import BlogHeader from '../../../components/BlogHeader.astro';
import { articles } from '../../../data/articles';
import { getBlogCardImage } from '../../../utils/blogImages';

export async function getStaticPaths() {
  const allTags = [...new Set(articles.flatMap((a) => a.tags))].filter(Boolean);

  return allTags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      tagArticles: articles.filter((a) => a.tags.includes(tag)),
    },
  }));
}

const { tag, tagArticles } = Astro.props;
---

<Layout
  lang="ja"
  title={`「${tag}」の記事一覧 — Snapmeal ブログ`}
  description={`ホットクック・献立・食材活用に関する「${tag}」タグの記事一覧です。`}
  alternateUrl="https://snap-meal.com/en/"
>
  <BlogHeader current="blog" />

  <main>
    <section class="bg-surface px-4 py-12 sm:py-16">
      <div class="max-w-5xl mx-auto">
        <a href="/blog/" class="inline-flex items-center text-sm font-bold text-primary mb-6 hover:underline underline-offset-4">
          ← ブログ一覧へ
        </a>
        <div class="flex items-center gap-3 mb-2">
          <span class="tag-badge">#{tag}</span>
          <span class="text-gray-400 text-sm font-bold">{tagArticles.length}件</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900">
          「{tag}」の記事一覧
        </h1>
      </div>
    </section>

    <section class="px-4 py-12 bg-white">
      <div class="max-w-5xl mx-auto grid gap-8">
        {tagArticles.map((article) => (
          <article class="grid md:grid-cols-[280px_1fr] gap-6 border border-gray-100 rounded-3xl p-4 sm:p-5 shadow-sm hover:shadow-md transition">
            <a href={article.href} class="block overflow-hidden rounded-2xl bg-surface">
              <img src={getBlogCardImage(article.image)} alt="" class="w-full h-full min-h-48 object-cover" loading="lazy" />
            </a>
            <div class="flex flex-col justify-center">
              <div class="flex flex-wrap items-center gap-3 text-xs font-bold text-gray-400 mb-3">
                <span class="text-primary bg-green-50 px-3 py-1 rounded-full">{article.category}</span>
                <time>{article.date}</time>
              </div>
              <h2 class="text-2xl font-extrabold text-gray-900 leading-[1.35] mb-3">
                <a href={article.href} class="hover:text-primary transition">{article.title}</a>
              </h2>
              <p class="text-gray-600 leading-relaxed mb-4">{article.description}</p>
              <div class="flex flex-wrap gap-2 mb-4">
                {article.tags.map((t) => (
                  <a
                    href={`/blog/tag/${encodeURIComponent(t)}/`}
                    class={`tag-chip ${t === tag ? 'tag-chip--active' : ''}`}
                  >
                    #{t}
                  </a>
                ))}
              </div>
              <a href={article.href} class="text-primary font-bold text-sm hover:underline underline-offset-4">
                記事を読む →
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="max-w-5xl mx-auto mt-12 pt-10 border-t border-gray-100">
        <h2 class="text-lg font-extrabold text-gray-900 mb-5">他のタグで探す</h2>
        <div class="all-tags">
          {[...new Set(articles.flatMap((a) => a.tags))].filter(Boolean).sort().map((t) => (
            <a
              href={`/blog/tag/${encodeURIComponent(t)}/`}
              class={`tag-chip ${t === tag ? 'tag-chip--active' : ''}`}
            >
              #{t}
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .tag-badge {
    display: inline-block;
    background: rgb(240 253 244);
    color: rgb(5 150 105);
    border: 1px solid rgb(167 243 208);
    font-size: 0.9rem;
    font-weight: 800;
    padding: 0.3rem 0.85rem;
    border-radius: 9999px;
  }
  .tag-chip {
    display: inline-block;
    background: rgb(243 244 246);
    color: rgb(75 85 99);
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    text-decoration: none;
    border: 1px solid rgb(229 231 235);
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .tag-chip:hover,
  .tag-chip--active {
    background: rgb(240 253 244);
    color: rgb(5 150 105);
    border-color: rgb(167 243 208);
  }
  .all-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>
