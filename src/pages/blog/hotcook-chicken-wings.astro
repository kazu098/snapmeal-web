    .recipe-cols h4 { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: rgb(107 114 128); font-weight: 800; margin: 0 0 0.6rem; }
    .recipe-cols ul, .recipe-cols ol { margin: 0; padding-left: 1.25rem; font-size: 0.9rem; line-height: 1.75; }
