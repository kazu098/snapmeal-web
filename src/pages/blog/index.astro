---
import Layout from '../../layouts/Layout.astro';
import BlogHeader from '../../components/BlogHeader.astro';

const articles = [
  {
    title: '子どもが食べるホットクック献立——「嫌いな野菜」を乗り越えるコツと定番3品',
    description:
      'カレー・肉じゃが・トマト煮の3品を中心に、ホットクックで子どもが食べやすい献立を作るコツと野菜嫌いへの対処法をまとめました。',
    href: '/blog/hotcook-kids-meal/',
    date: '2026年5月22日',
    category: 'ホットクック',
    image: '/blog/hotcook-kids-meal-thumbnail-1600x900.png',
  },
  {
    title: '冷蔵庫の残り野菜を全部スープにする——ホットクックでやる理由と4つの味の型',
    description:
      '野菜室の使いかけ食材をまとめてスープにするのがホットクックの得意技。和・洋・中華・みその4つの味型で、残り野菜を使い切る方法をまとめました。',
    href: '/blog/hotcook-leftover-soup/',
    date: '2026年5月22日',
    category: 'ホットクック',
    image: '/blog/hotcook-leftover-soup-thumbnail-1600x900.png',
  },
  {
    title: '豆腐・厚揚げはホットクックで化ける——崩さずに煮る方法と献立の広げ方',
    description:
      '豆腐は崩れやすいからホットクックは難しい、と思っていませんか。コツさえ知れば丁寧に仕上がります。味のバリエーションと実用的な献立パターンをまとめました。',
    href: '/blog/hotcook-tofu-aburaage-recipes/',
    date: '2026年5月22日',
    category: 'ホットクック',
    image: '/blog/hotcook-tofu-aburaage-thumbnail-1600x900.png',
  },
  {
    title: 'もう立ちたくない夜のホットクック——材料を切らずに作れる献立3つ',
    description:
      '帰り遅い、体がつらい、それでも夕飯は必要。包丁をほとんど使わず材料を入れるだけで完成する3パターンをまとめました。',
    href: '/blog/hotcook-tired-day-recipes/',
    date: '2026年5月22日',
    category: 'ホットクック',
    image: '/blog/hotcook-tired-day-thumbnail-1600x900.png',
  },
  {
    title: '鮭の切り身がある日のホットクック献立——和・洋・中華・みそ、全部いける',
    description:
      '鮭はホットクックで意外と使いやすい食材です。和風・洋風・中華風・みそ煮と味の方向が変えやすく、煮崩れもしにくい。切り身が余ったときの献立パターンをまとめました。',
    href: '/blog/hotcook-salmon-recipes/',
    date: '2026年5月22日',
    category: 'ホットクック',
    image: '/blog/hotcook-salmon-thumbnail-1600x900.png',
  },
  {
    title: 'ホットクックで豚バラ肉を使うなら？冷蔵庫の残り食材で作れる献立アイデア',
    description:
      'ホットクックで豚バラ肉を使うときに作りやすい献立、相性のよい野菜、失敗しにくい味付け、水分・脂の扱い方をまとめました。',
    href: '/blog/hotcook-pork-belly-recipes/',
    date: '2026年5月22日',
    category: 'ホットクック',
    image: '/blog/hotcook-pork-belly-thumbnail-1600x900.png',
  },
  {
    title: 'ホットクックで鶏もも肉を使うなら？冷蔵庫の残り食材で作れる献立アイデア',
    description:
      'ホットクックで鶏もも肉を使うときに作りやすい献立、相性のよい野菜、失敗しにくい味付け、水分量の考え方をまとめました。',
    href: '/blog/hotcook-chicken-thigh-recipes/',
    date: '2026年5月22日',
    category: 'ホットクック',
    image: '/blog/hotcook-chicken-thigh-thumbnail-1600x900.png',
  },
  {
    title: '冷蔵庫を撮るだけで、今夜の献立が30秒で決まる。──Snapmealをつくった話',
    description:
      'ホットクックを買ったのに使いこなせなかった体験から、冷蔵庫写真で献立を提案するSnapmealを作るまでの話。',
    href: '/blog/why-we-built-snapmeal/',
    date: '2026年5月22日',
    category: '開発ストーリー',
    image: '/og-ja.png',
  },
];
---

<Layout
  lang="ja"
  title="Snapmeal ブログ — 献立決め・冷蔵庫活用・ホットクックのヒント"
  description="Snapmealの開発ストーリー、冷蔵庫にある食材で献立を決めるコツ、ホットクック活用法などを発信します。"
  alternateUrl="https://snap-meal.com/en/"
>
  <BlogHeader current="blog" />

  <main>
    <section class="bg-surface px-4 py-16 sm:py-20">
      <div class="max-w-5xl mx-auto">
        <div class="max-w-3xl">
          <p class="text-sm font-bold text-primary mb-3">Snapmeal Blog</p>
          <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 leading-[1.25] mb-5">
            献立決めを、もっと軽くするためのブログ
          </h1>
          <p class="text-lg text-gray-600 leading-relaxed">
            冷蔵庫にある食材で献立を決めるコツ、ホットクック活用、Snapmealの開発背景をお届けします。
          </p>
        </div>
      </div>
    </section>

    <section class="px-4 py-14 bg-white">
      <div class="max-w-5xl mx-auto grid gap-8">
        {articles.map((article) => (
          <article class="grid md:grid-cols-[280px_1fr] gap-6 border border-gray-100 rounded-3xl p-4 sm:p-5 shadow-sm hover:shadow-md transition">
            <a href={article.href} class="block overflow-hidden rounded-2xl bg-surface">
              <img src={article.image} alt="" class="w-full h-full min-h-48 object-cover" loading="lazy" />
            </a>
            <div class="flex flex-col justify-center">
              <div class="flex flex-wrap items-center gap-3 text-xs font-bold text-gray-400 mb-3">
                <span class="text-primary bg-green-50 px-3 py-1 rounded-full">{article.category}</span>
                <time>{article.date}</time>
              </div>
              <h2 class="text-2xl font-extrabold text-gray-900 leading-[1.35] mb-3">
                <a href={article.href} class="hover:text-primary transition">{article.title}</a>
              </h2>
              <p class="text-gray-600 leading-relaxed mb-5">{article.description}</p>
              <a href={article.href} class="text-primary font-bold text-sm hover:underline underline-offset-4">
                記事を読む →
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>
