---
import Layout from '../../layouts/Layout.astro';

const APP_URL = 'https://app.snap-meal.com';
const FEEDBACK_URL = 'https://forms.gle/4bAHagjPBGp2fQDg6';

const steps = [
  {
    icon: '📸',
    title: 'Snap Your Fridge',
    desc: 'Take 1–3 photos of your fridge. Front, veggie drawer — any angle works. Gallery pick is fine too.',
  },
  {
    icon: '🤖',
    title: 'AI Reads the Ingredients',
    desc: "Google Gemini AI identifies what's inside automatically. You can review and edit the results.",
  },
  {
    icon: '🍽️',
    title: 'Dinner is Decided!',
    desc: 'Get 3 meal suggestions in 30 seconds. Pick your favorite and never fall into a cooking rut.',
  },
];

const features = [
  {
    icon: '🎯',
    title: 'AI Ingredient Detection',
    desc: "AI identifies ingredients from your fridge photo. You can add or remove items, so accuracy isn't critical.",
  },
  {
    icon: '🔄',
    title: 'No More Repetition',
    desc: 'Learns from the past 14 days of suggestions to prevent repeating the same meals, ingredients, or cuisine.',
  },
  {
    icon: '🥘',
    title: 'Smart Cooker Support',
    desc: 'Own a Smart Cooker (Hotcook)? Just toggle the setting and get recipes tailored for hands-free cooking.',
  },
  {
    icon: '⚡',
    title: 'Tired Mode',
    desc: 'Select "Tired" and Snapmeal prioritizes recipes under 15 minutes with fewer ingredients.',
  },
  {
    icon: '📖',
    title: 'Step-by-Step Recipes',
    desc: 'AI generates full recipes with ingredients, steps, and tips. Just tap "Cook this meal" to see it all.',
  },
  {
    icon: '📝',
    title: 'Family Reaction Notes',
    desc: 'Log "loved it" or "not again" — Snapmeal learns your family\'s preferences and improves future suggestions.',
  },
];

const faqs = [
  {
    q: 'How accurate is the ingredient detection?',
    a: 'Snapmeal uses Google Gemini 2.5, which handles common ingredients with high accuracy. If something is missed, you can easily add or remove it on the confirmation screen.',
  },
  {
    q: 'Are my photos stored on your servers?',
    a: 'No. Photos are used only during the meal suggestion process and are never stored on our servers. Privacy is our top priority.',
  },
  {
    q: 'Is it really free during beta?',
    a: 'Yes — all features are completely free during the beta period. We will notify you before any paid plan goes live.',
  },
  {
    q: 'Is a Smart Cooker required?',
    a: "Not at all — it's optional. Smart Cooker recipes are only shown when you enable the setting in preferences.",
  },
  {
    q: 'Can I exclude allergens?',
    a: 'Yes. Register your NG ingredients in settings and they will automatically be passed to the AI during meal suggestions. Note: this is not medical advice — always use your own judgment.',
  },
  {
    q: 'Do I need to download an app?',
    a: 'No download needed. Snapmeal runs in your browser. On mobile, tap "Add to Home Screen" in Safari or Chrome for an app-like experience.',
  },
];
---

<Layout lang="en" alternateUrl="https://snap-meal.com/">
  <!-- Beta banner -->
  <div class="bg-accent text-white text-center text-sm font-semibold py-2.5 px-4">
    🎉 Beta is now live · All features are free · <a href={FEEDBACK_URL} target="_blank" rel="noopener" class="underline underline-offset-2 hover:opacity-80 transition">Send feedback</a>
  </div>

  <!-- Navigation -->
  <header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-gray-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
      <a href="/en/" class="text-xl font-extrabold text-primary tracking-tight">Snapmeal</a>
      <nav class="hidden sm:flex items-center gap-6 text-sm font-medium text-gray-600">
        <a href="#how" class="hover:text-primary transition">How it works</a>
        <a href="#features" class="hover:text-primary transition">Features</a>
        <a href="#beta" class="hover:text-primary transition">Beta</a>
        <a href="/en/blog/" class="hover:text-primary transition">Blog</a>
        <a href="#faq" class="hover:text-primary transition">FAQ</a>
      </nav>
      <div class="flex items-center gap-3">
        <a href="/" class="text-xs font-semibold text-gray-400 hover:text-gray-700 transition border border-gray-200 px-3 py-1.5 rounded-full">日本語</a>
        <a
          href={APP_URL} target="_blank" rel="noopener noreferrer" data-ga-event="cta_click"
          class="bg-primary text-white text-sm font-bold px-5 py-2.5 rounded-full hover:bg-primary-dark transition shadow-md shadow-green-200"
        >
          Try beta free
        </a>
      </div>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <section class="bg-surface pt-16 pb-20 px-4">
      <div class="max-w-5xl mx-auto flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
        <!-- Text -->
        <div class="flex-1 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 bg-accent/10 text-accent text-xs font-bold px-4 py-1.5 rounded-full mb-6 tracking-wide">
            <span class="w-2 h-2 bg-accent rounded-full animate-pulse"></span>
            Beta now live · All features free
          </div>
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-gray-900 leading-tight mb-6">
            Just snap your fridge.<br />
            Dinner decided in <span class="text-primary">30 sec</span>.
          </h1>
          <p class="text-lg sm:text-xl text-gray-600 mb-10 leading-relaxed">
            No more "what's for dinner?" panic at 6 PM.<br class="hidden sm:block" />
            AI reads your fridge and suggests tonight's meal — instantly.
          </p>
          <div class="flex justify-center lg:justify-start">
            <a
              href={APP_URL} target="_blank" rel="noopener noreferrer" data-ga-event="cta_click"
              class="bg-primary text-white font-bold text-lg px-8 py-4 rounded-2xl hover:bg-primary-dark transition shadow-xl shadow-green-200 inline-block"
            >
              Try beta free
            </a>
          </div>
          <p class="text-xs text-gray-400 mt-4">No download · Works in your browser right now</p>
        </div>

        <!-- Hero video (iPhone frame) -->
        <div class="flex-shrink-0 relative">
          <!-- glow -->
          <div class="absolute inset-0 bg-gradient-to-b from-primary/15 to-green-200/10 rounded-[44px] blur-3xl scale-110"></div>
          <!-- iPhone shell -->
          <div class="relative w-64 sm:w-72 lg:w-80">
            <div class="relative bg-gray-900 rounded-[44px] p-3 shadow-2xl ring-1 ring-white/10">
              <!-- notch -->
              <div class="absolute top-3 left-1/2 -translate-x-1/2 w-24 h-6 bg-gray-900 rounded-b-2xl z-10 flex items-center justify-center gap-1.5">
                <div class="w-2 h-2 bg-gray-700 rounded-full"></div>
                <div class="w-10 h-2 bg-gray-800 rounded-full"></div>
              </div>
              <!-- screen -->
              <div class="overflow-hidden rounded-[34px] bg-black">
                <video
                  autoplay
                  muted
                  loop
                  playsinline
                  class="w-full h-auto block"
                  aria-label="Snapmeal app demo"
                >
                  <source src="/videos/hero-en.mp4" type="video/mp4" />
                </video>
              </div>
              <!-- home indicator -->
              <div class="flex justify-center pt-2 pb-0.5">
                <div class="w-28 h-1 bg-gray-600 rounded-full"></div>
              </div>
            </div>
          </div>
          <div class="absolute -bottom-4 left-1/2 -translate-x-1/2 w-40 h-5 bg-black/10 blur-xl rounded-full"></div>
        </div>
      </div>
    </section>

    <!-- Pain -->
    <section class="py-20 px-4 bg-white">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mb-3">
          Sound familiar?
        </h2>
        <p class="text-gray-500 mb-10">The everyday dinner struggles of a working parent.</p>
        <div class="grid sm:grid-cols-2 gap-4 text-left">
          {[
            'Open the fridge at 6 PM and go blank',
            'Cooking the same meals on repeat every week',
            'Too tired to think, but still need to plan dinner',
            'Bought groceries but have no idea what to make',
            'Unsure if the kids will actually eat it',
            'No time to search for recipes after work',
          ].map(text => (
            <div class="flex items-start gap-3 bg-red-50 rounded-2xl p-4 border border-red-100">
              <span class="text-red-400 mt-0.5 text-lg flex-shrink-0">✗</span>
              <p class="text-gray-700 text-sm font-medium">{text}</p>
            </div>
          ))}
        </div>
        <div class="mt-12 bg-surface rounded-3xl p-6 sm:p-8">
          <p class="text-2xl sm:text-3xl font-extrabold text-primary mb-2">100 min / month</p>
          <p class="text-gray-600 text-sm">
            Average time people spend deciding "what to cook"<br />(5 min × 20 weekdays)
          </p>
          <p class="text-gray-900 font-bold mt-4 text-lg">
            Snapmeal cuts that down to <span class="text-primary">30 seconds</span>.
          </p>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section id="how" class="py-20 px-4 bg-surface">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-14">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mb-3">Just 3 steps</h2>
          <p class="text-gray-500">No complex setup. Just snap your fridge with your phone.</p>
        </div>
        <div class="grid sm:grid-cols-3 gap-8">
          {steps.map((step, i) => {
            const screenshots = ['/screenshots/en/01-home.png', '/screenshots/en/02-upload.png', '/screenshots/en/03-meal.png'];
            const alts = ['Home screen — take a fridge photo and pick meal style', 'Uploading fridge photos', 'Meal suggestion — Chicken and Mini Tomato Stew'];
            return (
              <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden relative">
                <div class="absolute top-4 left-4 w-8 h-8 bg-primary text-white text-sm font-extrabold rounded-full flex items-center justify-center shadow-md z-10">
                  {i + 1}
                </div>
                <div class="bg-surface px-6 pt-10 pb-4 flex justify-center">
                  <img
                    src={screenshots[i]}
                    alt={alts[i]}
                    class="w-40 rounded-2xl shadow-lg border border-gray-100"
                    loading="lazy"
                  />
                </div>
                <div class="p-6 pt-4 text-center">
                  <div class="text-4xl mb-3">{step.icon}</div>
                  <h3 class="font-bold text-gray-900 text-lg mb-2">{step.title}</h3>
                  <p class="text-gray-500 text-sm leading-relaxed">{step.desc}</p>
                </div>
              </div>
            );
          })}
        </div>
        <div class="text-center mt-10">
          <a href={APP_URL} target="_blank" rel="noopener noreferrer" data-ga-event="cta_click" class="inline-block bg-accent text-white font-bold text-base px-8 py-4 rounded-2xl hover:opacity-90 transition shadow-lg shadow-orange-200">
            Try it now (free) →
          </a>
        </div>
      </div>
    </section>

    <!-- Add to Home Screen -->
    <section class="py-16 px-4 bg-white border-t border-gray-100">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-block bg-green-100 text-primary text-xs font-bold px-4 py-1.5 rounded-full mb-6 tracking-wide">
          No download needed
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mb-3">
          Add to your home screen for an app-like experience
        </h2>
        <p class="text-gray-500 mb-12">No App Store or Google Play required. Start right from your browser.</p>

        <div class="grid sm:grid-cols-2 gap-6 text-left">
          <!-- iOS -->
          <div class="bg-surface rounded-3xl p-6 border border-gray-100">
            <div class="flex items-center gap-3 mb-5">
              <span class="text-2xl"></span>
              <h3 class="font-bold text-gray-900 text-lg">iPhone (Safari)</h3>
            </div>
            <ol class="space-y-3">
              {[
                { step: '1', text: 'Open app.snap-meal.com in Safari' },
                { step: '2', text: 'Tap the Share button (□↑) at the bottom' },
                { step: '3', text: 'Select "Add to Home Screen"' },
                { step: '4', text: 'Tap "Add" — done!' },
              ].map(({ step, text }) => (
                <li class="flex items-start gap-3">
                  <span class="w-6 h-6 bg-primary text-white text-xs font-extrabold rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">{step}</span>
                  <span class="text-sm text-gray-600">{text}</span>
                </li>
              ))}
            </ol>
          </div>

          <!-- Android -->
          <div class="bg-surface rounded-3xl p-6 border border-gray-100">
            <div class="flex items-center gap-3 mb-5">
              <span class="text-2xl">🤖</span>
              <h3 class="font-bold text-gray-900 text-lg">Android (Chrome)</h3>
            </div>
            <ol class="space-y-3">
              {[
                { step: '1', text: 'Open app.snap-meal.com in Chrome' },
                { step: '2', text: 'Tap the ⋮ menu in the top right' },
                { step: '3', text: 'Select "Add to Home screen"' },
                { step: '4', text: 'Tap "Add" — done!' },
              ].map(({ step, text }) => (
                <li class="flex items-start gap-3">
                  <span class="w-6 h-6 bg-primary text-white text-xs font-extrabold rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">{step}</span>
                  <span class="text-sm text-gray-600">{text}</span>
                </li>
              ))}
            </ol>
          </div>
        </div>

        <div class="mt-8">
          <a href={APP_URL} target="_blank" rel="noopener noreferrer" data-ga-event="cta_click" class="inline-block bg-primary text-white font-bold px-8 py-4 rounded-2xl hover:bg-primary-dark transition shadow-lg shadow-green-200">
            Open in browser first →
          </a>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section id="features" class="py-20 px-4 bg-white">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-14">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mb-3">What Snapmeal does</h2>
          <p class="text-gray-500">Everything you need to end the dinner dilemma for good.</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {features.map(f => (
            <div class="bg-surface rounded-2xl p-5 border border-green-100">
              <div class="text-3xl mb-3">{f.icon}</div>
              <h3 class="font-bold text-gray-900 mb-2">{f.title}</h3>
              <p class="text-gray-500 text-sm leading-relaxed">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Recipe screenshot highlight -->
    <section class="py-20 px-4 bg-surface overflow-hidden">
      <div class="max-w-5xl mx-auto">
        <div class="flex flex-col lg:flex-row items-center gap-12">
          <div class="flex-1 text-center lg:text-left order-2 lg:order-1">
            <div class="inline-block bg-green-100 text-primary text-xs font-bold px-4 py-1.5 rounded-full mb-4 tracking-wide">
              Smart Cooker Ready
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mb-4 leading-tight">
              Full recipe, Smart Cooker<br />guide, and tips —<br />all generated by AI.
            </h2>
            <p class="text-gray-600 leading-relaxed mb-6">
              Tap "Cook this meal" and get the full recipe: exact quantities, step-by-step instructions, and your Smart Cooker's menu number. No searching, no switching apps.
            </p>
            <ul class="space-y-2 text-sm text-gray-700 mb-8">
              {[
                'Recipes made from what you already have',
                'Smart Cooker menu number & operation guide',
                'Cooking tips and techniques explained by AI',
              ].map(t => (
                <li class="flex items-center gap-2">
                  <span class="text-primary font-bold text-base">✓</span>
                  {t}
                </li>
              ))}
            </ul>
            <a href={APP_URL} target="_blank" rel="noopener noreferrer" data-ga-event="cta_click" class="inline-block bg-primary text-white font-bold px-7 py-3.5 rounded-2xl hover:bg-primary-dark transition shadow-lg shadow-green-200">
              Try beta free
            </a>
          </div>
          <div class="flex-shrink-0 order-1 lg:order-2 relative">
            <div class="absolute inset-0 bg-gradient-to-br from-primary/15 to-green-200/20 rounded-[40px] blur-3xl scale-110"></div>
            <img
              src="/screenshots/en/04-recipe.png"
              alt="Recipe detail screen — ingredients, steps, and Smart Cooker guide"
              class="relative w-56 sm:w-64 rounded-[32px] shadow-2xl border border-gray-100"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Beta / Pricing -->
    <section id="beta" class="py-20 px-4 bg-surface">
      <div class="max-w-2xl mx-auto text-center">
        <div class="inline-block bg-accent/10 text-accent text-xs font-bold px-4 py-1.5 rounded-full mb-6 tracking-wide">
          Beta
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mb-4">
          All features, free during beta
        </h2>
        <p class="text-gray-500 mb-10 leading-relaxed">
          Join the beta and try everything at no cost.<br />
          We'll give you advance notice before any paid plan launches.
        </p>

        <div class="bg-white rounded-3xl p-8 border-2 border-primary shadow-lg shadow-green-100 mb-8">
          <div class="flex items-center justify-center gap-2 mb-4">
            <span class="text-4xl font-extrabold text-gray-900">$0</span>
            <span class="text-gray-400">/ during beta</span>
          </div>
          <ul class="space-y-3 text-sm text-gray-600 mb-8 text-left max-w-xs mx-auto">
            {[
              'Unlimited meal suggestions',
              'AI ingredient detection & full recipes',
              'Smart Cooker operation guide',
              'Tired Mode',
              'Favorites, history & family notes',
              'Household settings (people, appliances, allergies)',
            ].map(item => (
              <li class="flex items-center gap-2">
                <span class="text-primary font-bold">✓</span>
                {item}
              </li>
            ))}
          </ul>
          <a href={APP_URL} target="_blank" rel="noopener noreferrer" data-ga-event="cta_click" class="block text-center bg-primary text-white font-bold py-4 rounded-xl hover:bg-primary-dark transition shadow-md shadow-green-200 text-lg">
            Join the beta (free)
          </a>
          <p class="text-xs text-gray-400 mt-3">No credit card · No download</p>
        </div>

        <p class="text-sm text-gray-500">
          Tried it? We'd love your feedback.<br />
          <a href={FEEDBACK_URL} target="_blank" rel="noopener" class="text-primary font-semibold hover:underline">
            Open feedback form →
          </a>
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="py-20 px-4 bg-white">
      <div class="max-w-2xl mx-auto">
        <div class="text-center mb-14">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mb-3">Frequently asked questions</h2>
        </div>
        <div class="space-y-4">
          {faqs.map(({ q, a }) => (
            <details class="group bg-surface rounded-2xl border border-gray-100 overflow-hidden">
              <summary class="flex items-center justify-between px-6 py-4 cursor-pointer font-semibold text-gray-800 list-none">
                <span>{q}</span>
                <span class="text-gray-400 group-open:rotate-45 transition-transform text-xl">+</span>
              </summary>
              <div class="px-6 pb-5 text-gray-600 text-sm leading-relaxed">{a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="py-24 px-4 bg-primary-dark text-center">
      <div class="max-w-xl mx-auto">
        <div class="inline-block bg-white/20 text-white text-xs font-bold px-4 py-1.5 rounded-full mb-6 tracking-wide">
          Beta · Free
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-4">
          Stop stressing over dinner.<br />Start cooking.
        </h2>
        <p class="text-green-200 mb-10 text-lg">
          Snap your fridge. Dinner in 30 seconds.<br />
          All features free during beta.
        </p>
        <a
          href={APP_URL} target="_blank" rel="noopener noreferrer" data-ga-event="cta_click"
          class="inline-block bg-white text-primary font-extrabold text-lg px-10 py-5 rounded-2xl hover:bg-surface transition shadow-2xl"
        >
          Try beta free →
        </a>
        <p class="text-green-300 text-sm mt-4">No download · Works in your browser right now</p>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="bg-gray-900 text-gray-400 py-12 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="flex flex-col sm:flex-row justify-between items-start gap-8 mb-8">
        <div>
          <p class="text-white font-extrabold text-xl mb-2">Snapmeal</p>
          <p class="text-sm">AI meal planner for everyone.<br />Snap your fridge. Dinner in 30 seconds.</p>
          <p class="text-xs text-accent font-semibold mt-2">Beta now live</p>
        </div>
        <nav class="flex flex-col gap-2 text-sm">
          <a href={APP_URL} target="_blank" rel="noopener noreferrer" data-ga-event="cta_click" class="hover:text-white transition">Open the app</a>
          <a href={FEEDBACK_URL} target="_blank" rel="noopener" class="hover:text-white transition">Send feedback</a>
          <a href="/privacy" class="hover:text-white transition">Privacy Policy</a>
          <a href="/terms" class="hover:text-white transition">Terms of Service</a>
          <a href="#faq" class="hover:text-white transition">FAQ</a>
          <a href="/" class="hover:text-white transition">日本語</a>
        </nav>
      </div>
      <div class="border-t border-gray-800 pt-6 text-xs text-gray-600 flex flex-col sm:flex-row justify-between gap-2">
        <p>© 2026 Snapmeal. All rights reserved.</p>
        <p>
          ⚠️ Always check the freshness and expiry of ingredients yourself. Snapmeal's suggestions are not medical advice.
        </p>
      </div>
    </div>
  </footer>
</Layout>
