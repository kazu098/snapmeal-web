---
import Layout from '../../../layouts/Layout.astro';
import BlogHeader from '../../../components/BlogHeader.astro';

const APP_URL = 'https://app.snap-meal.com';
---

<Layout
  lang="en"
  title="v0.9 Update — Taste Learning Visibility & iOS Fixes | Snapmeal"
  description="Snapmeal v0.9: The AI's personalization is now visible — see when your history is being used to optimize suggestions. iOS onboarding and swipe navigation also improved."
  alternateUrl="https://snap-meal.com/updates/v09/"
>
  <BlogHeader current="blog" />

  <main class="bg-white">
    <!-- Header -->
    <section class="bg-surface px-4 py-12 sm:py-16">
      <div class="max-w-2xl mx-auto">
        <a href="/en/updates/" class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-primary mb-6 transition">
          ← All updates
        </a>
        <div class="flex items-center gap-3 mb-4">
          <span class="text-3xl font-extrabold text-primary">v0.9</span>
          <span class="text-sm text-gray-400 font-semibold">May 2026</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 leading-tight mb-3">
          Taste Learning Visibility & iOS Fixes
        </h1>
        <p class="text-gray-500 leading-relaxed">
          Snapmeal has always learned from your meal history, reactions, and favorites — now that learning is visible on screen. iOS onboarding display and swipe navigation are also fixed in this release.
        </p>
      </div>
    </section>

    <!-- ① Learning Visibility -->
    <section class="px-4 py-12 border-t border-gray-100">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-xl font-extrabold text-gray-900 mb-2">🧠 Your personalization is now visible</h2>
        <p class="text-gray-500 text-sm mb-6 leading-relaxed">
          Snapmeal has always used your past 14 days of meal history, liked/disliked reactions, and favorites to personalize suggestions. Until now, that was invisible. v0.9 makes it apparent.
        </p>

        <div class="space-y-5 mb-6">
          <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm">
            <p class="text-sm font-bold text-gray-900 mb-1">Loading message changes based on your history</p>
            <p class="text-sm text-gray-500 leading-relaxed mb-3">
              When you're logged in and have meal history, the loading screen shows a personalized message. First-time users see the standard message; returning users see the learning message.
            </p>
            <div class="flex justify-center mb-4">
              <img
                src="/updates/v09-analyzing-learning.png"
                alt="Loading screen — spinner with '🧠 Learning your preferences...' message"
                class="w-[200px] rounded-[1.5rem] shadow-xl shadow-gray-200 border border-gray-100"
              />
            </div>
            <div class="flex flex-col sm:flex-row gap-3">
              <div class="flex-1 bg-gray-50 rounded-xl px-4 py-3 text-sm text-center">
                <p class="text-gray-400 text-xs mb-1">Guest / First use</p>
                <p class="font-medium text-gray-700">🍳 Planning your meal...</p>
              </div>
              <div class="flex-1 bg-green-50 rounded-xl px-4 py-3 text-sm text-center border border-green-100">
                <p class="text-primary text-xs font-bold mb-1">With history</p>
                <p class="font-medium text-gray-700">🧠 Learning your preferences...</p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm">
            <p class="text-sm font-bold text-gray-900 mb-1">Personalization badge on meal cards</p>
            <p class="text-sm text-gray-500 leading-relaxed mb-4">
              When a suggestion is optimized from your past history, a "🧠 Tailored to your taste" badge appears above the dish name.
            </p>
            <div class="flex justify-center">
              <img
                src="/updates/v09-result-badge.png"
                alt="Meal result screen — '🧠 Tailored to your taste' badge above the dish name"
                class="w-[200px] rounded-[1.5rem] shadow-xl shadow-gray-200 border border-gray-100"
              />
            </div>
          </div>

          <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm">
            <p class="text-sm font-bold text-gray-900 mb-1">More specific "why this dish?" explanations</p>
            <p class="text-sm text-gray-500 leading-relaxed">
              The reason text shown under each suggestion now references your history when available — e.g. "different from last week's meals" or "reflects genres you've enjoyed."
            </p>
          </div>
        </div>

        <div class="bg-green-50 border border-green-200 rounded-2xl p-4 text-sm text-green-800 leading-relaxed">
          <strong>Gets smarter with every use</strong><br />
          The more you use Snapmeal, the more tailored the suggestions become. Leave a reaction note ("loved it" / "not great") after cooking and it's automatically reflected in the next suggestion.
        </div>
      </div>
    </section>

    <!-- ② iOS Fixes -->
    <section class="px-4 py-12 bg-surface border-t border-gray-100">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-xl font-extrabold text-gray-900 mb-2">📱 iOS display improvements</h2>
        <p class="text-gray-500 text-sm mb-6 leading-relaxed">
          Two fixes for users running Snapmeal as a home screen app on iPhone.
        </p>

        <div class="space-y-4">
          <div class="bg-white rounded-2xl p-5 border border-gray-100">
            <p class="text-sm font-bold text-gray-900 mb-2">Onboarding no longer requires scrolling</p>
            <div class="grid sm:grid-cols-2 gap-3">
              <div class="bg-red-50 rounded-xl px-4 py-3 text-xs text-red-700">
                <p class="font-semibold mb-1">Before</p>
                <p>The "Next" button was hidden below the fold, requiring a scroll to proceed through setup</p>
              </div>
              <div class="bg-green-50 rounded-xl px-4 py-3 text-xs text-green-700 border border-green-100">
                <p class="font-semibold mb-1">After</p>
                <p>All buttons fit on screen on any iPhone size — no scrolling needed</p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-2xl p-5 border border-gray-100">
            <p class="text-sm font-bold text-gray-900 mb-2">Swipe loops back from the last suggestion</p>
            <div class="grid sm:grid-cols-2 gap-3">
              <div class="bg-red-50 rounded-xl px-4 py-3 text-xs text-red-700">
                <p class="font-semibold mb-1">Before</p>
                <p>Swiping right on the 3rd (last) suggestion did nothing</p>
              </div>
              <div class="bg-green-50 rounded-xl px-4 py-3 text-xs text-green-700 border border-green-100">
                <p class="font-semibold mb-1">After</p>
                <p>Swiping right on the last suggestion loops back to the first</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="px-4 py-16 bg-white border-t border-gray-100 text-center">
      <p class="text-sm text-gray-500 mb-4">Try the latest version</p>
      <a
        href={APP_URL}
        data-ga-event="cta_click"
        class="inline-block bg-primary text-white font-bold px-8 py-3.5 rounded-full hover:bg-primary-dark transition shadow-lg shadow-green-100"
      >
        Open Snapmeal (Beta · Free)
      </a>
      <div class="mt-6">
        <a href="/en/updates/" class="text-sm text-gray-400 hover:text-primary transition">← All updates</a>
      </div>
    </section>
  </main>
</Layout>
