---
import Layout from '../../../layouts/Layout.astro';
import BlogHeader from '../../../components/BlogHeader.astro';

const APP_URL = 'https://app.snap-meal.com';
---

<Layout
  lang="en"
  title="v0.6 Priority Ingredients & Cuisine Style — Snapmeal"
  description="Snapmeal v0.6: Tap to mark ingredients you want to use today. Added cuisine style selector — Japanese, Western, Chinese, Korean, Ethnic, and One-plate."
  alternateUrl="https://snap-meal.com/updates/v06/"
>
  <BlogHeader current="blog" />

  <main class="bg-white">
    <section class="bg-surface px-4 py-12 sm:py-16">
      <div class="max-w-2xl mx-auto">
        <a href="/en/updates/" class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-primary mb-6 transition">
          ← All updates
        </a>
        <div class="flex items-center gap-3 mb-4">
          <span class="text-3xl font-extrabold text-primary">v0.6</span>
          <span class="text-sm text-gray-400 font-semibold">May 2026</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 leading-tight mb-3">
          Priority Ingredients & Cuisine Style
        </h1>
        <p class="text-gray-500 leading-relaxed">
          After scanning your fridge, tap any ingredient to mark it as a priority. Also added a cuisine style selector — Japanese, Western, Chinese, Korean, Ethnic, or One-plate.
        </p>
      </div>
    </section>

    <section class="px-4 py-12 border-t border-gray-100">
      <div class="max-w-2xl mx-auto space-y-10">

        <div>
          <h2 class="text-xl font-extrabold text-gray-900 mb-2">Tap to prioritize ingredients</h2>
          <p class="text-gray-500 text-sm mb-6 leading-relaxed">
            After fridge recognition, an ingredient confirmation screen is shown. Tap any ingredient to highlight it as a priority — AI will make sure it's featured in the dish.
          </p>
          <div class="flex justify-center mb-6">
            <img
              src="/updates/v06-ingredient-priority.png"
              alt="Ingredient confirmation screen — tapped items shown with priority badge"
              class="w-[200px] rounded-[1.5rem] shadow-xl shadow-gray-200 border border-gray-100"
            />
          </div>
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="bg-white rounded-2xl p-4 border border-gray-100">
              <p class="text-sm font-bold text-gray-800 mb-1">Selection is optional</p>
              <p class="text-xs text-gray-500 leading-relaxed">Leave everything unselected and AI suggests from all ingredients as usual. Only mark the ones you specifically want to use today.</p>
            </div>
            <div class="bg-white rounded-2xl p-4 border border-gray-100">
              <p class="text-sm font-bold text-gray-800 mb-1">Remove misrecognized items</p>
              <p class="text-xs text-gray-500 leading-relaxed">Tap the × button to remove any ingredient AI got wrong. Priority marking and removal are separate actions.</p>
            </div>
          </div>
        </div>

        <div>
          <h2 class="text-xl font-extrabold text-gray-900 mb-2">Cuisine style selector</h2>
          <p class="text-gray-500 text-sm mb-6 leading-relaxed">
            Choose a cuisine style before generating your meal suggestion. The AI will stick to that style while still using your available ingredients.
          </p>
          <div class="flex justify-center">
            <img
              src="/updates/v06-genre-select.png"
              alt="Cuisine style selection — Japanese, Western, Chinese, Korean, Ethnic, One-plate chips"
              class="w-[200px] rounded-[1.5rem] shadow-xl shadow-gray-200 border border-gray-100"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="px-4 py-16 bg-surface border-t border-gray-100 text-center">
      <p class="text-sm text-gray-500 mb-4">Try the latest version</p>
      <a href={APP_URL} data-ga-event="cta_click" class="inline-block bg-primary text-white font-bold px-8 py-3.5 rounded-full hover:bg-primary-dark transition shadow-lg shadow-green-100">
        Open Snapmeal (Beta · Free)
      </a>
      <div class="mt-6">
        <a href="/en/updates/" class="text-sm text-gray-400 hover:text-primary transition">← All updates</a>
      </div>
    </section>
  </main>
</Layout>
