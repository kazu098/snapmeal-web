---
import Layout from '../../../layouts/Layout.astro';
import BlogHeader from '../../../components/BlogHeader.astro';

const APP_URL = 'https://app.snap-meal.com';
const TESTFLIGHT_URL = 'https://testflight.apple.com/join/PdAtaK4f';
---

<Layout
  lang="en"
  title="v0.10 Update — iOS App Beta Released | Snapmeal"
  description="Snapmeal v0.10: The iOS native app is now available on TestFlight. Also added account deletion support and an error recovery button."
  alternateUrl="https://snap-meal.com/updates/v10/"
>
  <BlogHeader current="blog" />

  <main class="bg-white">
    <!-- Header -->
    <section class="bg-surface px-4 py-12 sm:py-16">
      <div class="max-w-2xl mx-auto">
        <a href="/en/updates/" class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-primary mb-6 transition">
          ← All updates
        </a>
        <div class="flex items-center gap-3 mb-4">
          <span class="text-3xl font-extrabold text-primary">v0.10</span>
          <span class="text-sm text-gray-400 font-semibold">May 2026</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 leading-tight mb-3">
          iOS App Beta Released
        </h1>
        <p class="text-gray-500 leading-relaxed">
          Snapmeal is now available as a native iPhone app via TestFlight. This update also adds account deletion support and an in-app error recovery button.
        </p>
      </div>
    </section>

    <!-- ① iOS Beta -->
    <section class="px-4 py-12 border-t border-gray-100">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-xl font-extrabold text-gray-900 mb-2">📱 iOS App Beta on TestFlight</h2>
        <p class="text-gray-500 text-sm mb-6 leading-relaxed">
          Snapmeal was previously only available in the browser. You can now install it directly on your iPhone as a native app via TestFlight.
        </p>

        <div class="space-y-4 mb-6">
          <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm">
            <p class="text-sm font-bold text-gray-900 mb-1">A native app experience</p>
            <p class="text-sm text-gray-500 leading-relaxed">
              An icon on your home screen, faster launch, and tighter integration with iOS features like the camera.
            </p>
          </div>

          <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm">
            <p class="text-sm font-bold text-gray-900 mb-2">How to install</p>
            <ol class="space-y-2 text-sm text-gray-500">
              <li class="flex gap-2"><span class="flex-none font-bold text-primary">1.</span><span>Open the link in Safari on your iPhone</span></li>
              <li class="flex gap-2"><span class="flex-none font-bold text-primary">2.</span><span>Install the TestFlight app if you haven't already</span></li>
              <li class="flex gap-2"><span class="flex-none font-bold text-primary">3.</span><span>Install the Snapmeal beta</span></li>
            </ol>
          </div>
        </div>

        <a
          href={TESTFLIGHT_URL}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2.5 bg-gray-900 text-white font-bold text-base px-7 py-3.5 rounded-2xl hover:bg-gray-700 transition shadow-lg"
        >
          <svg class="w-5 h-5 flex-none" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
          Install on TestFlight
        </a>
      </div>
    </section>

    <!-- ② Account Deletion -->
    <section class="px-4 py-12 bg-surface border-t border-gray-100">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-xl font-extrabold text-gray-900 mb-2">🗑️ Account Deletion</h2>
        <p class="text-gray-500 text-sm mb-5 leading-relaxed">
          You can now request account deletion directly from the settings screen.
        </p>

        <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm">
          <p class="text-sm font-bold text-gray-900 mb-2">How it works</p>
          <ol class="space-y-2 text-sm text-gray-500">
            <li class="flex gap-2"><span class="flex-none font-bold text-primary">1.</span><span>Open Settings and tap "Delete account"</span></li>
            <li class="flex gap-2"><span class="flex-none font-bold text-primary">2.</span><span>A confirmation modal shows what data will be deleted</span></li>
            <li class="flex gap-2"><span class="flex-none font-bold text-primary">3.</span><span>Tap "Open deletion request page" to send a deletion request by email</span></li>
          </ol>
          <p class="text-xs text-gray-400 mt-4">Deletion is usually completed within 30 days of identity verification.</p>
        </div>
      </div>
    </section>

    <!-- ③ Error Recovery -->
    <section class="px-4 py-12 border-t border-gray-100">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-xl font-extrabold text-gray-900 mb-2">🔄 Error Recovery Button</h2>
        <p class="text-gray-500 text-sm mb-5 leading-relaxed">
          When an error occurs during analysis, a "Start over" button now appears on the spot — no need to reload the page.
        </p>

        <div class="grid sm:grid-cols-2 gap-3">
          <div class="bg-red-50 rounded-xl px-4 py-3 text-xs text-red-700">
            <p class="font-semibold mb-1">Before</p>
            <p>A full page reload was required to recover from an analysis error</p>
          </div>
          <div class="bg-green-50 rounded-xl px-4 py-3 text-xs text-green-700 border border-green-100">
            <p class="font-semibold mb-1">After</p>
            <p>A "Start over" button appears inline — tap once to retry immediately</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="px-4 py-16 bg-white border-t border-gray-100 text-center">
      <p class="text-sm text-gray-500 mb-4">Try the latest version</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href={TESTFLIGHT_URL}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center gap-2 bg-gray-900 text-white font-bold px-7 py-3.5 rounded-full hover:bg-gray-700 transition shadow-lg"
        >
          <svg class="w-5 h-5 flex-none" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
          Install iOS app
        </a>
        <a
          href={APP_URL}
          data-ga-event="cta_click"
          class="inline-block bg-primary text-white font-bold px-8 py-3.5 rounded-full hover:bg-primary-dark transition shadow-lg shadow-green-100"
        >
          Try the web version
        </a>
      </div>
      <div class="mt-6">
        <a href="/en/updates/" class="text-sm text-gray-400 hover:text-primary transition">← All updates</a>
      </div>
    </section>
  </main>
</Layout>
