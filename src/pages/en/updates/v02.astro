---
import Layout from '../../../layouts/Layout.astro';
import BlogHeader from '../../../components/BlogHeader.astro';

const APP_URL = 'https://app.snap-meal.com';
---

<Layout
  lang="en"
  title="v0.2 Hotcook Recipe Improvements — Snapmeal"
  description="Snapmeal v0.2: Enhanced Hotcook recipe screen with menu selection guide, substitution notes, and finishing tips."
  alternateUrl="https://snap-meal.com/updates/v02/"
>
  <BlogHeader current="blog" />

  <main class="bg-white">
    <section class="bg-surface px-4 py-12 sm:py-16">
      <div class="max-w-2xl mx-auto">
        <a href="/en/updates/" class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-primary mb-6 transition">
          ← All updates
        </a>
        <div class="flex items-center gap-3 mb-4">
          <span class="text-3xl font-extrabold text-primary">v0.2</span>
          <span class="text-sm text-gray-400 font-semibold">May 2026</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 leading-tight mb-3">
          Hotcook Recipe Improvements
        </h1>
        <p class="text-gray-500 leading-relaxed">
          For Hotcook users: the recipe screen is now more actionable with menu selection guidance, ingredient substitution notes, and finishing tips.
        </p>
      </div>
    </section>

    <section class="px-4 py-12 border-t border-gray-100">
      <div class="max-w-2xl mx-auto space-y-10">
        <div>
          <h2 class="text-xl font-extrabold text-gray-900 mb-2">Menu selection guide</h2>
          <p class="text-gray-500 text-sm mb-4 leading-relaxed">
            The recipe screen now shows the Hotcook menu path: which category to navigate to, which auto-menu number to select, and how long it will take. No more guessing which button to press.
          </p>
          <div class="bg-green-50 border border-green-200 rounded-2xl p-4 text-sm text-green-800">
            Example: <strong>Simmered dishes → Root vegetables → Auto-menu #23 → Start</strong> (approx. 35 min)
          </div>
        </div>

        <div>
          <h2 class="text-xl font-extrabold text-gray-900 mb-2">Substitution notes & finishing tips</h2>
          <p class="text-gray-500 text-sm mb-4 leading-relaxed">
            If a seasoning or ingredient isn't in your pantry, AI suggests a practical substitute. Finishing tips help with plating and last-minute flavor adjustments.
          </p>
          <div class="space-y-3">
            <div class="flex gap-4 p-4 rounded-2xl border border-gray-100">
              <span class="text-2xl flex-shrink-0">🔄</span>
              <div>
                <p class="font-bold text-gray-800 text-sm">Substitution notes</p>
                <p class="text-xs text-gray-500 mt-0.5 leading-relaxed">e.g. "No curry roux? Use 2 tbsp curry powder + 1 tbsp flour." Practical alternatives using what you have.</p>
              </div>
            </div>
            <div class="flex gap-4 p-4 rounded-2xl border border-gray-100">
              <span class="text-2xl flex-shrink-0">✨</span>
              <div>
                <p class="font-bold text-gray-800 text-sm">Finishing tips</p>
                <p class="text-xs text-gray-500 mt-0.5 leading-relaxed">Plating ideas and seasoning adjustments after cooking to elevate the finished dish.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="px-4 py-16 bg-surface border-t border-gray-100 text-center">
      <p class="text-sm text-gray-500 mb-4">Try the latest version</p>
      <a href={APP_URL} data-ga-event="cta_click" class="inline-block bg-primary text-white font-bold px-8 py-3.5 rounded-full hover:bg-primary-dark transition shadow-lg shadow-green-100">
        Open Snapmeal (Beta · Free)
      </a>
      <div class="mt-6">
        <a href="/en/updates/" class="text-sm text-gray-400 hover:text-primary transition">← All updates</a>
      </div>
    </section>
  </main>
</Layout>
