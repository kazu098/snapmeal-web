---
import Layout from '../../../layouts/Layout.astro';
import BlogHeader from '../../../components/BlogHeader.astro';

const APP_URL = 'https://app.snap-meal.com';
---

<Layout
  lang="en"
  title="v0.7 Priority Ingredient Fix & Better English Meals — Snapmeal"
  description="Snapmeal v0.7: Priority ingredients now carry through all alternative suggestions. English users get more globally relevant meal ideas."
  alternateUrl="https://snap-meal.com/updates/v07/"
>
  <BlogHeader current="blog" />

  <main class="bg-white">
    <section class="bg-surface px-4 py-12 sm:py-16">
      <div class="max-w-2xl mx-auto">
        <a href="/en/updates/" class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-primary mb-6 transition">
          ← All updates
        </a>
        <div class="flex items-center gap-3 mb-4">
          <span class="text-3xl font-extrabold text-primary">v0.7</span>
          <span class="text-sm text-gray-400 font-semibold">May 2026</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 leading-tight mb-3">
          Priority Ingredient Fix & Better English Meals
        </h1>
        <p class="text-gray-500 leading-relaxed">
          Priority ingredients now carry through to all alternative suggestions. English users get meal ideas that actually fit Western kitchens and pantries.
        </p>
      </div>
    </section>

    <section class="px-4 py-12 border-t border-gray-100">
      <div class="max-w-2xl mx-auto space-y-10">

        <div>
          <h2 class="text-xl font-extrabold text-gray-900 mb-2">Priority ingredients in all alternatives</h2>
          <p class="text-gray-500 text-sm mb-6 leading-relaxed">
            Previously, priority ingredients were used in the first suggestion but sometimes dropped from the alternative suggestions ("Show another meal"). Now they carry through all three slots.
          </p>
          <div class="flex justify-center mb-6">
            <img
              src="/updates/v07-priority-confirm.png"
              alt="Ingredient confirmation — priority ingredient marked in amber"
              class="w-[200px] rounded-[1.5rem] shadow-xl shadow-gray-200 border border-gray-100"
            />
          </div>
          <div class="bg-green-50 border border-green-200 rounded-2xl p-4 text-sm text-green-800">
            <strong>How it works now</strong><br />
            Specified ingredients are included in all suggestions generated in the session — not just the first one.
          </div>
        </div>

        <div>
          <h2 class="text-xl font-extrabold text-gray-900 mb-2">Better meal suggestions for English users</h2>
          <p class="text-gray-500 text-sm mb-6 leading-relaxed">
            English-language sessions now prioritize globally familiar dishes over Japanese defaults. The pantry staples list was also updated to match what's actually in a Western kitchen.
          </p>
          <div class="flex justify-center mb-6">
            <img
              src="/updates/v07-en-meal.png"
              alt="English meal suggestion — pasta carbonara with Western-style recipe"
              class="w-[200px] rounded-[1.5rem] shadow-xl shadow-gray-200 border border-gray-100"
            />
          </div>
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="bg-white rounded-2xl p-4 border border-gray-100">
              <p class="text-sm font-bold text-gray-800 mb-1">Meal suggestions updated</p>
              <p class="text-xs text-gray-500 leading-relaxed">Pasta, grilled chicken, tacos, soups, stews, grain bowls — dishes common in Western households are now prioritized.</p>
            </div>
            <div class="bg-white rounded-2xl p-4 border border-gray-100">
              <p class="text-sm font-bold text-gray-800 mb-1">Pantry staples updated</p>
              <p class="text-xs text-gray-500 leading-relaxed">Replaced Japanese-specific condiments (mirin, mentsuyu) with cumin, paprika, dried herbs, Dijon mustard, and other Western staples.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="px-4 py-16 bg-surface border-t border-gray-100 text-center">
      <p class="text-sm text-gray-500 mb-4">Try the latest version</p>
      <a href={APP_URL} data-ga-event="cta_click" class="inline-block bg-primary text-white font-bold px-8 py-3.5 rounded-full hover:bg-primary-dark transition shadow-lg shadow-green-100">
        Open Snapmeal (Beta · Free)
      </a>
      <div class="mt-6">
        <a href="/en/updates/" class="text-sm text-gray-400 hover:text-primary transition">← All updates</a>
      </div>
    </section>
  </main>
</Layout>
