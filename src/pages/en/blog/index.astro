---
import Layout from '../../../layouts/Layout.astro';
import BlogHeader from '../../../components/BlogHeader.astro';

const articles = [
  {
    title: 'Just Snap Your Fridge. Dinner Decided in 30 Seconds. The Story Behind Snapmeal',
    description:
      'Why Snapmeal started: from struggling to use a Hotcook well, to building an AI meal-planning web app for real weeknight cooking.',
    href: '/en/blog/why-we-built-snapmeal/',
    date: 'May 22, 2026',
    category: 'Product Story',
    image: '/og-en.png',
  },
  {
    title: 'What to Cook with Chicken Thigh in a Hotcook? Meal Ideas from What’s in Your Fridge',
    description:
      'A practical guide for Hotcook and smart cooker users: chicken thigh meal ideas, vegetable pairings, seasoning directions, and common mistakes to avoid.',
    href: '/en/blog/hotcook-chicken-thigh-recipes/',
    date: 'May 22, 2026',
    category: 'Smart Cooker',
    image: '/blog/hotcook-chicken-thigh-thumbnail-1600x900.png',
  },
];
---

<Layout
  lang="en"
  title="Snapmeal Blog — Smart Cooker Tips, Fridge Meals, and AI Meal Planning"
  description="Practical articles about smart cooker meals, using what is already in your fridge, and how Snapmeal helps you decide dinner faster."
  alternateUrl="https://snap-meal.com/blog/"
>
  <BlogHeader lang="en" current="blog" />

  <main>
    <section class="bg-surface px-4 py-16 sm:py-20">
      <div class="max-w-5xl mx-auto">
        <div class="max-w-3xl">
          <p class="text-sm font-bold text-primary mb-3">Snapmeal Blog</p>
          <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 leading-[1.25] mb-5">
            Practical ideas for easier dinner decisions
          </h1>
          <p class="text-lg text-gray-600 leading-relaxed">
            Smart cooker tips, fridge-based meal planning, and product stories from Snapmeal.
          </p>
        </div>
      </div>
    </section>

    <section class="px-4 py-14 bg-white">
      <div class="max-w-5xl mx-auto grid gap-8">
        {articles.map((article) => (
          <article class="grid md:grid-cols-[280px_1fr] gap-6 border border-gray-100 rounded-3xl p-4 sm:p-5 shadow-sm hover:shadow-md transition">
            <a href={article.href} class="block overflow-hidden rounded-2xl bg-surface">
              <img src={article.image} alt="" class="w-full h-full min-h-48 object-cover" loading="lazy" />
            </a>
            <div class="flex flex-col justify-center">
              <div class="flex flex-wrap items-center gap-3 text-xs font-bold text-gray-400 mb-3">
                <span class="text-primary bg-green-50 px-3 py-1 rounded-full">{article.category}</span>
                <time>{article.date}</time>
              </div>
              <h2 class="text-2xl font-extrabold text-gray-900 leading-[1.35] mb-3">
                <a href={article.href} class="hover:text-primary transition">{article.title}</a>
              </h2>
              <p class="text-gray-600 leading-relaxed mb-5">{article.description}</p>
              <a href={article.href} class="text-primary font-bold text-sm hover:underline underline-offset-4">
                Read article →
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>
