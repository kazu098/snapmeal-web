---
import Layout from '../layouts/Layout.astro';

const APP_URL = 'https://ai-recipe-murex.vercel.app';

const steps = [
  {
    icon: '📸',
    title: '冷蔵庫を撮影',
    desc: '正面・野菜室など1〜3枚撮るだけ。ギャラリーからの選択もOK。',
  },
  {
    icon: '🤖',
    title: 'AIが食材を認識',
    desc: 'Google Gemini AIが食材を自動識別。認識結果は確認・編集できます。',
  },
  {
    icon: '🍽️',
    title: '献立が決まる！',
    desc: '30秒で今夜の夕食を提案。3案から選べるのでマンネリ知らず。',
  },
];

const features = [
  {
    icon: '🎯',
    title: 'AI食材認識',
    desc: '撮った写真からAIが食材を自動識別。認識結果は自分で追加・削除できるので精度に依存しすぎません。',
  },
  {
    icon: '🔄',
    title: 'マンネリ回避',
    desc: '過去14日間の提案履歴を学習。同じ料理・食材・ジャンルの繰り返しを自動的に防ぎます。',
  },
  {
    icon: '🥘',
    title: 'ホットクック対応',
    desc: 'ホットクックをお持ちの方は設定するだけ。自動調理鍋で作れる料理のみを厳選提案します。',
  },
  {
    icon: '🛒',
    title: '買い物リスト',
    desc: '不足食材を自動でリスト化。ワンタップでコピーしてそのままLINEで共有できます。',
  },
  {
    icon: '⚡',
    title: '疲れた日モード',
    desc: '「疲れた」を選ぶと15分以内・材料少なめの超時短レシピを優先提案します。',
  },
  {
    icon: '📖',
    title: 'ステップレシピ',
    desc: '材料・手順・コツをAIが生成。「この献立で作る」を押すだけで詳細レシピが表示されます。',
  },
];

const faqs = [
  {
    q: '食材の認識精度はどのくらいですか？',
    a: 'Google Gemini 2.5 を使用しており、一般的な食材は高精度で認識します。万が一、認識もれがあっても確認画面で追加・削除できるのでご安心ください。',
  },
  {
    q: '写真はサーバーに保存されますか？',
    a: 'いいえ。写真は献立提案の処理中のみ使用し、サーバーには一切保存しません。プライバシーを最優先に設計しています。',
  },
  {
    q: '無料でどこまで使えますか？',
    a: 'ログイン後は月10回まで無料で全機能をご利用いただけます。ログイン前のゲストでも3回お試しいただけます。',
  },
  {
    q: 'Proプランはいつでも解約できますか？',
    a: 'はい、アプリ内の設定画面からいつでも解約できます。解約後も期間終了まで引き続きご利用いただけます。',
  },
  {
    q: 'ホットクックは必須ですか？',
    a: 'いいえ、任意です。設定画面でホットクックをONにした場合のみ、ホットクック対応レシピが優先表示されます。',
  },
  {
    q: 'アレルギー食材は除外できますか？',
    a: 'はい。設定画面でNG食材を登録しておくと、献立提案時にAIへ自動で伝えます。医療的助言ではないため、最終判断はご自身でお願いします。',
  },
];
---

<Layout lang="ja" alternateUrl="https://snap-meal.com/en/">
  <!-- ナビゲーション -->
  <header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-gray-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
      <a href="/" class="text-xl font-extrabold text-primary tracking-tight">Snapmeal</a>
      <nav class="hidden sm:flex items-center gap-6 text-sm font-medium text-gray-600">
        <a href="#how" class="hover:text-primary transition">使い方</a>
        <a href="#features" class="hover:text-primary transition">機能</a>
        <a href="#pricing" class="hover:text-primary transition">料金</a>
        <a href="#faq" class="hover:text-primary transition">FAQ</a>
      </nav>
      <div class="flex items-center gap-3">
        <a href="/en/" class="text-xs font-semibold text-gray-400 hover:text-gray-700 transition border border-gray-200 px-3 py-1.5 rounded-full">EN</a>
        <a
          href={APP_URL}
          class="bg-primary text-white text-sm font-bold px-5 py-2.5 rounded-full hover:bg-primary-dark transition shadow-md shadow-green-200"
        >
          無料で始める
        </a>
      </div>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <section class="bg-surface pt-16 pb-20 px-4">
      <div class="max-w-5xl mx-auto flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
        <!-- Text -->
        <div class="flex-1 text-center lg:text-left">
          <div class="inline-block bg-green-100 text-primary text-xs font-bold px-4 py-1.5 rounded-full mb-6 tracking-wide">
            共働き家庭のための AI 献立アシスタント
          </div>
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-gray-900 leading-normal mb-6">
            冷蔵庫を撮るだけ。<br />
            <span class="text-primary">30秒</span>で今夜の<br class="sm:hidden" />夕食が決まる。
          </h1>
          <p class="text-lg sm:text-xl text-gray-600 mb-10 leading-relaxed">
            平日18時の「今夜どうしよう」から解放される。<br class="hidden sm:block" />
            AIが食材を認識して、今夜の献立を自動で提案します。
          </p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center lg:justify-start">
            <a
              href={APP_URL}
              class="bg-primary text-white font-bold text-lg px-8 py-4 rounded-2xl hover:bg-primary-dark transition shadow-xl shadow-green-200 inline-block"
            >
              無料で試してみる
            </a>
            <a
              href="#how"
              class="bg-white text-gray-700 font-semibold text-lg px-8 py-4 rounded-2xl border-2 border-gray-200 hover:border-primary transition inline-block"
            >
              使い方を見る
            </a>
          </div>
          <p class="text-sm text-muted mt-4">クレジットカード不要 · ゲストで3回無料</p>
        </div>

        <!-- App screenshot / 動画がある場合はここを <video autoplay muted loop playsinline> に差し替える -->
        <div class="flex-shrink-0 relative">
          <div class="relative">
            <div class="absolute inset-0 bg-gradient-to-b from-primary/15 to-green-200/10 rounded-[44px] blur-3xl scale-110"></div>
            <img
              src="/screenshots/ja/01-home.png"
              alt="Snapmeal アプリ画面 - 冷蔵庫を撮影して献立を選ぶ"
              class="relative w-64 sm:w-72 lg:w-80 rounded-[36px] shadow-2xl border border-gray-100"
              width="330"
              height="714"
              loading="eager"
            />
          </div>
          <div class="absolute -bottom-4 left-1/2 -translate-x-1/2 w-40 h-5 bg-black/10 blur-xl rounded-full"></div>
        </div>
      </div>
    </section>

    <!-- Pain -->
    <section class="py-20 px-4 bg-white">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mb-3">
          毎日こんなこと、ありませんか？
        </h2>
        <p class="text-gray-500 mb-10">共働き家庭の親なら誰もが感じる、平日夕方のリアルな悩み。</p>
        <div class="grid sm:grid-cols-2 gap-4 text-left">
          {[
            '18時に冷蔵庫を開けても何も思い浮かばない',
            '毎週同じ料理ばかりでマンネリ気味',
            '疲れているのに献立を考えなければならない',
            '買い物したのに何を作るか決まらない',
            '子どもが食べてくれるか毎回不安',
            'レシピを調べる時間すら惜しい',
          ].map(text => (
            <div class="flex items-start gap-3 bg-red-50 rounded-2xl p-4 border border-red-100">
              <span class="text-red-400 mt-0.5 text-lg flex-shrink-0">✗</span>
              <p class="text-gray-700 text-sm font-medium">{text}</p>
            </div>
          ))}
        </div>
        <div class="mt-12 bg-surface rounded-3xl p-6 sm:p-8">
          <p class="text-2xl sm:text-3xl font-extrabold text-primary mb-2">月100分</p>
          <p class="text-gray-600 text-sm">
            共働き夫婦が「今夜何作ろう」と悩む時間の平均<br />（平日5分 × 20日間）
          </p>
          <p class="text-gray-900 font-bold mt-4 text-lg">
            Snapmeal なら、その悩みを <span class="text-primary">30秒</span> に縮めます。
          </p>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section id="how" class="py-20 px-4 bg-surface">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-14">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mb-3">たった3ステップ</h2>
          <p class="text-gray-500">難しい操作は一切なし。スマホで冷蔵庫を撮るだけ。</p>
        </div>
        <div class="grid sm:grid-cols-3 gap-8">
          {steps.map((step, i) => {
            const screenshots = ['/screenshots/ja/01-home.png', '/screenshots/ja/02-upload.png', '/screenshots/ja/03-meal.png'];
            const alts = ['ホーム画面 - 写真を撮って献立スタイルを選択', '冷蔵庫の写真をアップロード中', '献立提案画面 - さばと白菜のオイスターソース炒め'];
            return (
              <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden relative">
                <div class="absolute top-4 left-4 w-8 h-8 bg-primary text-white text-sm font-extrabold rounded-full flex items-center justify-center shadow-md z-10">
                  {i + 1}
                </div>
                <div class="bg-surface px-6 pt-10 pb-4 flex justify-center">
                  <img
                    src={screenshots[i]}
                    alt={alts[i]}
                    class="w-40 rounded-2xl shadow-lg border border-gray-100"
                    loading="lazy"
                  />
                </div>
                <div class="p-6 pt-4 text-center">
                  <div class="text-4xl mb-3">{step.icon}</div>
                  <h3 class="font-bold text-gray-900 text-lg mb-2">{step.title}</h3>
                  <p class="text-gray-500 text-sm leading-relaxed">{step.desc}</p>
                </div>
              </div>
            );
          })}
        </div>
        <div class="text-center mt-10">
          <a href={APP_URL} class="inline-block bg-accent text-white font-bold text-base px-8 py-4 rounded-2xl hover:opacity-90 transition shadow-lg shadow-orange-200">
            今すぐ試してみる →
          </a>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section id="features" class="py-20 px-4 bg-white">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-14">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mb-3">Snapmeal の機能</h2>
          <p class="text-gray-500">毎日使いたくなる機能を揃えました。</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {features.map(f => (
            <div class="bg-surface rounded-2xl p-5 border border-green-100">
              <div class="text-3xl mb-3">{f.icon}</div>
              <h3 class="font-bold text-gray-900 mb-2">{f.title}</h3>
              <p class="text-gray-500 text-sm leading-relaxed">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Recipe screenshot highlight -->
    <section class="py-20 px-4 bg-surface overflow-hidden">
      <div class="max-w-5xl mx-auto">
        <div class="flex flex-col lg:flex-row items-center gap-12">
          <div class="flex-1 text-center lg:text-left order-2 lg:order-1">
            <div class="inline-block bg-green-100 text-primary text-xs font-bold px-4 py-1.5 rounded-full mb-4 tracking-wide">
              ホットクック対応
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mb-4 leading-tight">
              AIが材料・手順・<br />ホットクック設定まで<br />まとめて生成。
            </h2>
            <p class="text-gray-600 leading-relaxed mb-6">
              「この献立で作る」を押すだけで、材料の分量から調理手順、ホットクックの操作ガイドまで自動生成。レシピを調べる手間がゼロになります。
            </p>
            <ul class="space-y-2 text-sm text-gray-700 mb-8">
              {['今ある食材だけで作れるレシピを提案', 'ホットクックのメニュー番号まで案内', '調理ポイント・コツもAIが解説'].map(t => (
                <li class="flex items-center gap-2">
                  <span class="text-primary font-bold text-base">✓</span>
                  {t}
                </li>
              ))}
            </ul>
            <a href={APP_URL} class="inline-block bg-primary text-white font-bold px-7 py-3.5 rounded-2xl hover:bg-primary-dark transition shadow-lg shadow-green-200">
              無料で試してみる
            </a>
          </div>
          <div class="flex-shrink-0 order-1 lg:order-2 relative">
            <div class="absolute inset-0 bg-gradient-to-br from-primary/15 to-green-200/20 rounded-[40px] blur-3xl scale-110"></div>
            <img
              src="/screenshots/ja/04-recipe.png"
              alt="レシピ詳細画面 - 材料・手順・ホットクックガイド"
              class="relative w-56 sm:w-64 rounded-[32px] shadow-2xl border border-gray-100"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section id="pricing" class="py-20 px-4 bg-surface">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-14">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mb-3">シンプルな料金</h2>
          <p class="text-gray-500">まずは無料で。気に入ったらProへ。</p>
        </div>
        <div class="grid sm:grid-cols-2 gap-6">
          <!-- Free -->
          <div class="bg-white rounded-3xl p-8 border-2 border-gray-200 shadow-sm">
            <p class="font-bold text-gray-500 text-sm mb-1">Free</p>
            <div class="flex items-end gap-1 mb-6">
              <span class="text-4xl font-extrabold text-gray-900">¥0</span>
              <span class="text-gray-400 mb-1">/ 月</span>
            </div>
            <ul class="space-y-3 text-sm text-gray-600 mb-8">
              {[
                '月10回まで献立提案',
                'AI食材認識',
                'レシピ詳細',
                '買い物リスト',
                '家庭設定（人数・調理器具）',
              ].map(item => (
                <li class="flex items-center gap-2">
                  <span class="text-primary font-bold">✓</span>
                  {item}
                </li>
              ))}
            </ul>
            <a href={APP_URL} class="block text-center border-2 border-primary text-primary font-bold py-3 rounded-xl hover:bg-surface transition">
              無料で始める
            </a>
          </div>

          <!-- Pro -->
          <div class="bg-primary rounded-3xl p-8 shadow-2xl shadow-green-300 relative overflow-hidden">
            <div class="absolute top-4 right-4 bg-accent text-white text-xs font-bold px-3 py-1 rounded-full">
              おすすめ
            </div>
            <p class="font-bold text-green-200 text-sm mb-1">Pro</p>
            <div class="flex items-end gap-1 mb-6">
              <span class="text-4xl font-extrabold text-white">¥980</span>
              <span class="text-green-200 mb-1">/ 月</span>
            </div>
            <ul class="space-y-3 text-sm text-green-100 mb-8">
              {[
                '月90回まで献立提案（回数を気にせず毎日使える）',
                'Freeの全機能',
                'お気に入り献立の保存',
                '家族の反応メモ',
                '履歴閲覧（過去20セッション）',
              ].map(item => (
                <li class="flex items-start gap-2">
                  <span class="text-white font-bold mt-0.5 flex-shrink-0">✓</span>
                  {item}
                </li>
              ))}
            </ul>
            <a href={APP_URL} class="block text-center bg-white text-primary font-bold py-3 rounded-xl hover:bg-surface transition">
              Pro を始める
            </a>
          </div>
        </div>

        <div class="mt-8 bg-white rounded-2xl p-6 border border-gray-100 text-sm text-gray-600">
          <p class="font-semibold text-gray-800 mb-2">💡 コスパで考えると</p>
          <p>「今夜何作ろう」と悩む時間は平日5分×20日 = <strong>月100分</strong>。時給¥1,500換算で<strong>¥2,500相当</strong>を、¥980で解決できます。Spotifyと同額で、毎日の夕食の意思決定を丸ごとAIに任せられます。</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="py-20 px-4 bg-white">
      <div class="max-w-2xl mx-auto">
        <div class="text-center mb-14">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mb-3">よくある質問</h2>
        </div>
        <div class="space-y-4">
          {faqs.map(({ q, a }) => (
            <details class="group bg-surface rounded-2xl border border-gray-100 overflow-hidden">
              <summary class="flex items-center justify-between px-6 py-4 cursor-pointer font-semibold text-gray-800 list-none">
                <span>{q}</span>
                <span class="text-gray-400 group-open:rotate-45 transition-transform text-xl">+</span>
              </summary>
              <div class="px-6 pb-5 text-gray-600 text-sm leading-relaxed">{a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="py-24 px-4 bg-primary-dark text-center">
      <div class="max-w-xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-4">
          今夜の献立、<br />もう悩まなくていい。
        </h2>
        <p class="text-green-200 mb-10 text-lg">
          冷蔵庫を撮って、30秒で決まる。<br />
          まずは無料でお試しください。
        </p>
        <a
          href={APP_URL}
          class="inline-block bg-white text-primary font-extrabold text-lg px-10 py-5 rounded-2xl hover:bg-surface transition shadow-2xl"
        >
          無料で始める →
        </a>
        <p class="text-green-300 text-sm mt-4">クレジットカード不要 · ゲストで3回無料</p>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="bg-gray-900 text-gray-400 py-12 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="flex flex-col sm:flex-row justify-between items-start gap-8 mb-8">
        <div>
          <p class="text-white font-extrabold text-xl mb-2">Snapmeal</p>
          <p class="text-sm">冷蔵庫を撮るだけで今夜の献立が決まる、<br />共働き家庭のためのAI献立アシスタント。</p>
        </div>
        <nav class="flex flex-col gap-2 text-sm">
          <a href={APP_URL} class="hover:text-white transition">アプリを開く</a>
          <a href="/privacy" class="hover:text-white transition">プライバシーポリシー</a>
          <a href="/terms" class="hover:text-white transition">利用規約</a>
          <a href="#faq" class="hover:text-white transition">よくある質問</a>
        </nav>
      </div>
      <div class="border-t border-gray-800 pt-6 text-xs text-gray-600 flex flex-col sm:flex-row justify-between gap-2">
        <p>© 2026 Snapmeal. All rights reserved.</p>
        <p>
          ⚠️ 食材の賞味期限・鮮度はご自身でご確認ください。本サービスの提案は医療的助言ではありません。
        </p>
      </div>
    </div>
  </footer>
</Layout>
