---
import Layout from '../../layouts/Layout.astro';
import BlogHeader from '../../components/BlogHeader.astro';

const APP_URL = 'https://app.snap-meal.com';

type UpdateEntry = {
  version: string;
  slug: string;
  date: string;
  title: string;
  description: string;
  items: string[];
};

const updates: UpdateEntry[] = [
  {
    version: 'v0.6',
    slug: 'v06',
    date: '2026年5月',
    title: '食材を使いたい順に選べるように・ジャンル選択',
    description: '写真解析後に「今日使いたい食材」をタップ指定できるようになりました。献立スタイル（和食・洋食・中華など）の選択も追加。',
    items: [
      '食材オプトイン指定 — 解析後の食材一覧でタップすると「優先使用」にマーク。指定した食材をAIが必ず料理に使います',
      '指定は任意 — 何もタップしなければ全食材から提案。使い切りたい食材だけ選べます',
      '別の献立にも反映 — 優先指定した食材は「別のコンダテを見る」の候補にも反映されます',
      'ジャンル選択 — 和食・洋食・中華・エスニックなどスタイルを事前に指定して提案を絞れます',
    ],
  },
  {
    version: 'v0.5',
    slug: 'v05',
    date: '2026年5月',
    title: 'お気に入り・不要フラグ・買い物リストコピー',
    description: '毎日使うほど提案が好みに近づく仕組みと、献立後の「次のアクション」を使いやすくしました。',
    items: [
      '不足食材をワンタップでコピー — 買い物リストとしてそのまま使えます',
      'お気に入り保存 — 気に入った献立を一覧で見返せるように',
      '興味なし機能 — 次回以降の提案から除外。好みを蓄積できます',
      'AIがお気に入りを学習 — 保存した献立のジャンルを次回の提案に反映',
      '「作った！」ボタンを改善 — シンプルなトグル1つに整理',
    ],
  },
  {
    version: 'v0.2',
    slug: 'v02',
    date: '2026年5月',
    title: 'ホットクックレシピ強化',
    description: 'ホットクックユーザー向けに、レシピ画面をより使いやすく改善しました。',
    items: [
      'メニュー選択セクション — 自動メニュー番号と手動設定を案内',
      '代用メモ — 調味料が足りないときの代替案を表示',
      '仕上げのコツ — 盛り付け・味の調整ポイントを追加',
    ],
  },
  {
    version: 'v0.1',
    slug: 'v01',
    date: '2026年4月',
    title: 'ベータ版ローンチ',
    description: '「冷蔵庫を撮るだけで献立が決まる」AIアプリのベータ版を公開しました。',
    items: [
      '冷蔵庫写真からAIが食材を自動認識',
      '3候補から献立を選択、レシピをその場で生成',
      '疲れた日モード — 15分以内の料理だけを提案',
      'ホットクック対応 — 自動メニュー案内つきレシピ',
      '献立履歴 — 過去の提案を記録してマンネリ防止',
      '日本語・英語対応',
    ],
  },
];
---

<Layout
  lang="ja"
  title="アップデート履歴 — Snapmeal"
  description="Snapmealの最新アップデート・機能追加・改善内容の一覧です。"
>
  <BlogHeader current="blog" />

  <main>
    <section class="bg-surface px-4 py-14 sm:py-20">
      <div class="max-w-2xl mx-auto text-center">
        <p class="text-sm font-bold text-primary mb-3">What's New</p>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 leading-tight mb-4">
          アップデート履歴
        </h1>
        <p class="text-gray-500 text-base leading-relaxed">
          Snapmealの最新機能・改善内容をまとめています。<br />
          ベータ版は毎週アップデート中です。
        </p>
        <a
          href={APP_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-ga-event="cta_click"
          class="inline-block mt-6 bg-primary text-white font-bold px-6 py-3 rounded-full hover:bg-primary-dark transition shadow-md"
        >
          最新版を試す（無料）
        </a>
      </div>
    </section>

    <section class="px-4 py-12 bg-white">
      <div class="max-w-2xl mx-auto">
        <div class="relative">
          <div class="absolute left-[5.5rem] top-0 bottom-0 w-px bg-gray-100 hidden sm:block"></div>

          <div class="space-y-12">
            {updates.map((update) => (
              <div class="sm:grid sm:grid-cols-[7rem_1fr] sm:gap-8 group">
                <div class="flex sm:flex-col sm:items-end gap-3 sm:gap-1 mb-4 sm:mb-0 sm:pt-0.5">
                  <span class="text-lg font-extrabold text-primary">{update.version}</span>
                  <span class="text-xs text-gray-400 font-semibold sm:text-right">{update.date}</span>
                </div>

                <div class="relative">
                  <div class="absolute -left-[2.1rem] top-1.5 w-3 h-3 rounded-full bg-primary border-2 border-white shadow-sm hidden sm:block"></div>

                  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 hover:shadow-md transition">
                    <h2 class="text-lg font-extrabold text-gray-900 mb-1">{update.title}</h2>
                    <p class="text-sm text-gray-500 mb-4 leading-relaxed">{update.description}</p>
                    <ul class="space-y-1.5 mb-4">
                      {update.items.map((item) => (
                        <li class="flex items-start gap-2 text-sm text-gray-700">
                          <span class="text-primary mt-0.5 flex-shrink-0">✓</span>
                          <span class="leading-relaxed">{item}</span>
                        </li>
                      ))}
                    </ul>
                    <a
                      href={`/updates/${update.slug}/`}
                      class="inline-flex items-center gap-1 text-sm font-semibold text-primary hover:underline"
                    >
                      詳細を見る →
                    </a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-16 text-center">
          <a
            href={APP_URL}
            target="_blank"
            rel="noopener noreferrer"
            data-ga-event="cta_click"
            class="inline-block bg-primary text-white font-bold px-8 py-3.5 rounded-full hover:bg-primary-dark transition shadow-lg shadow-green-100"
          >
            Snapmealを試す（ベータ・無料）
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
