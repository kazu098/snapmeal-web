---
import Layout from '../../layouts/Layout.astro';
import BlogHeader from '../../components/BlogHeader.astro';

const APP_URL = 'https://app.snap-meal.com';
const TESTFLIGHT_URL = 'https://testflight.apple.com/join/PdAtaK4f';
const ANDROID_BETA_URL = 'https://play.google.com/apps/testing/app.snapmeal.android';
---

<Layout
  lang="ja"
  title="v0.11 アップデート — Androidアプリ ベータ版リリース | Snapmeal"
  description="Snapmeal v0.11：AndroidネイティブアプリのベータテストをGoogle Playで公開。iOSに続き、Androidでもホーム画面からネイティブ体験でご利用いただけます。"
>
  <BlogHeader current="blog" />

  <main class="bg-white">
    <!-- ヘッダー -->
    <section class="bg-surface px-4 py-12 sm:py-16">
      <div class="max-w-2xl mx-auto">
        <a href="/updates/" class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-primary mb-6 transition">
          ← アップデート一覧
        </a>
        <div class="flex items-center gap-3 mb-4">
          <span class="text-3xl font-extrabold text-primary">v0.11</span>
          <span class="text-sm text-gray-400 font-semibold">2026年5月</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 leading-tight mb-3">
          Androidアプリ ベータ版リリース
        </h1>
        <p class="text-gray-500 leading-relaxed">
          Google Play のクローズドテストとして、Android ネイティブアプリのベータ版を公開しました。iOSに続き、Androidでもホーム画面にアイコンを追加してネイティブ体験でご利用いただけます。
        </p>
      </div>
    </section>

    <!-- ① Android ベータ -->
    <section class="px-4 py-12 border-t border-gray-100">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-xl font-extrabold text-gray-900 mb-2">🤖 Androidアプリ（Google Play）ベータ版を公開</h2>
        <p class="text-gray-500 text-sm mb-6 leading-relaxed">
          Google Play のクローズドテストで Snapmeal の Android ネイティブアプリを配信開始しました。テスト参加リンクからインストールできます。
        </p>

        <div class="flex justify-center mb-8">
          <img
            src="/updates/v11-android-beta.png"
            alt="Google Play の Snapmeal テスト参加画面 — アプリアイコン・インストールボタン"
            class="w-[200px] rounded-[1.5rem] shadow-xl shadow-gray-200 border border-gray-100"
          />
        </div>

        <div class="space-y-4 mb-6">
          <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm">
            <p class="text-sm font-bold text-gray-900 mb-1">ネイティブアプリならではの体験</p>
            <p class="text-sm text-gray-500 leading-relaxed">
              ホーム画面にアイコンが追加され、起動がスムーズに。カメラなど Android の機能とより自然に連携します。
            </p>
          </div>

          <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm">
            <p class="text-sm font-bold text-gray-900 mb-2">インストール方法</p>
            <ol class="space-y-2 text-sm text-gray-500">
              <li class="flex gap-2"><span class="flex-none font-bold text-primary">1.</span><span>Android 端末のブラウザでリンクを開く</span></li>
              <li class="flex gap-2"><span class="flex-none font-bold text-primary">2.</span><span>「テスターになる」をタップしてテストに参加</span></li>
              <li class="flex gap-2"><span class="flex-none font-bold text-primary">3.</span><span>Google Play から Snapmeal をインストール</span></li>
            </ol>
          </div>
        </div>

        <a
          href={ANDROID_BETA_URL}
          target="_blank"
          rel="noopener"
          data-ga-event="android_beta_click"
          class="inline-flex items-center gap-2.5 bg-gray-900 text-white font-bold text-base px-7 py-3.5 rounded-2xl hover:bg-gray-700 transition shadow-lg"
        >
          <svg class="w-5 h-5 flex-none" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.523 15.341 19.953 11a.89.89 0 0 0-.323-1.214.89.89 0 0 0-1.214.323l-2.475 4.427a8.1 8.1 0 0 1-3.94 1.004 8.1 8.1 0 0 1-3.942-1.004L5.584 10.11a.89.89 0 0 0-1.214-.323A.89.89 0 0 0 4.047 11l2.43 4.341A8.6 8.6 0 0 0 11 17.91V20H8.5a.5.5 0 0 0 0 1h7a.5.5 0 0 0 0-1H13v-2.09a8.6 8.6 0 0 0 4.523-2.569M8.748 5.15 7.434 2.826a.3.3 0 0 0-.41-.109.3.3 0 0 0-.109.41L8.25 5.49A8.1 8.1 0 0 1 12 4.54a8.1 8.1 0 0 1 3.75.95l1.335-2.363a.3.3 0 0 0-.109-.41.3.3 0 0 0-.41.11L15.252 5.15A7.9 7.9 0 0 0 12 4.34a7.9 7.9 0 0 0-3.252.81M10 9a1 1 0 1 0 0 2 1 1 0 0 0 0-2m4 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2"/>
          </svg>
          Google Play でインストールする
        </a>
      </div>
    </section>

    <!-- CTA -->
    <section class="px-4 py-16 bg-white border-t border-gray-100 text-center">
      <p class="text-sm text-gray-500 mb-4">最新版をお試しください</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href={ANDROID_BETA_URL}
          target="_blank"
          rel="noopener"
          data-ga-event="android_beta_click"
          class="inline-flex items-center justify-center gap-2 bg-gray-900 text-white font-bold px-7 py-3.5 rounded-full hover:bg-gray-700 transition shadow-lg"
        >
          <svg class="w-5 h-5 flex-none" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.523 15.341 19.953 11a.89.89 0 0 0-.323-1.214.89.89 0 0 0-1.214.323l-2.475 4.427a8.1 8.1 0 0 1-3.94 1.004 8.1 8.1 0 0 1-3.942-1.004L5.584 10.11a.89.89 0 0 0-1.214-.323A.89.89 0 0 0 4.047 11l2.43 4.341A8.6 8.6 0 0 0 11 17.91V20H8.5a.5.5 0 0 0 0 1h7a.5.5 0 0 0 0-1H13v-2.09a8.6 8.6 0 0 0 4.523-2.569M8.748 5.15 7.434 2.826a.3.3 0 0 0-.41-.109.3.3 0 0 0-.109.41L8.25 5.49A8.1 8.1 0 0 1 12 4.54a8.1 8.1 0 0 1 3.75.95l1.335-2.363a.3.3 0 0 0-.109-.41.3.3 0 0 0-.41.11L15.252 5.15A7.9 7.9 0 0 0 12 4.34a7.9 7.9 0 0 0-3.252.81M10 9a1 1 0 1 0 0 2 1 1 0 0 0 0-2m4 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2"/>
          </svg>
          Androidアプリをインストール
        </a>
        <a
          href={TESTFLIGHT_URL}
          target="_blank"
          rel="noopener"
          data-ga-event="testflight_click"
          class="inline-flex items-center justify-center gap-2 border border-gray-200 text-gray-600 font-bold px-7 py-3.5 rounded-full hover:bg-gray-50 transition"
        >
          <svg class="w-5 h-5 flex-none" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
          iOSアプリをインストール
        </a>
        <a
          href={APP_URL}
          data-ga-event="cta_click"
          class="inline-block bg-primary text-white font-bold px-8 py-3.5 rounded-full hover:bg-primary-dark transition shadow-lg shadow-green-100"
        >
          ブラウザ版を試す
        </a>
      </div>
      <div class="mt-6">
        <a href="/updates/" class="text-sm text-gray-400 hover:text-primary transition">← アップデート一覧に戻る</a>
      </div>
    </section>
  </main>
</Layout>
