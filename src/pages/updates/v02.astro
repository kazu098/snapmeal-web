---
import Layout from '../../layouts/Layout.astro';
import BlogHeader from '../../components/BlogHeader.astro';

const APP_URL = 'https://app.snap-meal.com';
---

<Layout
  lang="ja"
  title="v0.2 アップデート — ホットクックレシピ強化 | Snapmeal"
  description="Snapmeal v0.2：ホットクックのメニュー選択ガイド、調味料の代用メモ、仕上げのコツを追加。ホットクックユーザー向けにレシピ画面を大幅改善。"
>
  <BlogHeader current="blog" />

  <main class="bg-white">
    <!-- ヘッダー -->
    <section class="bg-surface px-4 py-12 sm:py-16">
      <div class="max-w-2xl mx-auto">
        <a href="/updates/" class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-primary mb-6 transition">
          ← アップデート一覧
        </a>
        <div class="flex items-center gap-3 mb-4">
          <span class="text-3xl font-extrabold text-primary">v0.2</span>
          <span class="text-sm text-gray-400 font-semibold">2026年5月</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 leading-tight mb-3">
          ホットクックレシピ強化
        </h1>
        <p class="text-gray-500 leading-relaxed">
          ホットクックユーザー向けに、レシピ画面を3つの観点で改善しました。
        </p>
      </div>
    </section>

    <!-- メニュー選択 -->
    <section class="px-4 py-12 border-t border-gray-100">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-xl font-extrabold text-gray-900 mb-2">メニュー選択セクション</h2>
        <p class="text-gray-500 text-sm mb-6 leading-relaxed">
          レシピ画面に「メニュー選択」セクションを追加。AIが料理に合った自動メニュー番号を案内するので、ホットクック本体を操作するときに迷いません。自動メニューがない機種向けに手動設定（まぜる・煮物など）もガイドします。
        </p>

        <div class="flex justify-center mb-8">
          <div class="relative">
            <img
              src="/updates/recipe-hotcook.png"
              alt="ホットクックレシピ — メニュー選択セクション"
              class="w-[220px] rounded-[2rem] shadow-2xl shadow-gray-300 border border-gray-100"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- 代用メモ・仕上げのコツ -->
    <section class="px-4 py-12 bg-surface border-t border-gray-100">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-xl font-extrabold text-gray-900 mb-2">代用メモ・仕上げのコツ</h2>
        <p class="text-gray-500 text-sm mb-6 leading-relaxed">
          「調味料が足りない」ときのために代替案をレシピ内に表示。また、盛り付けや味の最終調整ポイントを「仕上げのコツ」として追加しました。
        </p>

        <div class="flex justify-center mb-8">
          <div class="relative">
            <img
              src="/updates/recipe-tips.png"
              alt="レシピ画面 — 代用メモと仕上げのコツ"
              class="w-[220px] rounded-[2rem] shadow-2xl shadow-gray-300 border border-gray-100"
            />
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-4">
          <div class="bg-white rounded-2xl border border-gray-100 p-4 shadow-sm">
            <p class="text-sm font-bold text-gray-800 mb-1">🔄 代用メモ</p>
            <p class="text-xs text-gray-500 leading-relaxed">「カレールーがない場合：カレー粉大さじ2＋小麦粉」のように、調味料の代替案をAIが自動提案。冷蔵庫にあるもので代用できます。</p>
          </div>
          <div class="bg-white rounded-2xl border border-gray-100 p-4 shadow-sm">
            <p class="text-sm font-bold text-gray-800 mb-1">💡 仕上げのコツ</p>
            <p class="text-xs text-gray-500 leading-relaxed">盛り付けの工夫や、加熱後の味の調整ポイントをアドバイス。毎回の料理がワンランクアップします。</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="px-4 py-16 border-t border-gray-100 text-center">
      <p class="text-sm text-gray-500 mb-4">ホットクックをお持ちの方はぜひお試しください</p>
      <a
        href={APP_URL}
        data-ga-event="cta_click"
        class="inline-block bg-primary text-white font-bold px-8 py-3.5 rounded-full hover:bg-primary-dark transition shadow-lg shadow-green-100"
      >
        Snapmealを試す（ベータ・無料）
      </a>
      <div class="mt-6">
        <a href="/updates/" class="text-sm text-gray-400 hover:text-primary transition">← アップデート一覧に戻る</a>
      </div>
    </section>
  </main>
</Layout>
